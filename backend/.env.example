# ── Flora Alchemy API — environment template ─────────────────────────────
# Copy to backend/.env and fill in real values. Never commit .env.

# API server
PORT=4000
NODE_ENV=development

# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017/flora_alchemy

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ── Razorpay — TEST MODE ONLY (Phase 3E) ─────────────────────────────────
# Use only rzp_test_... keys. When these are absent the checkout keeps its
# frozen prototype behavior (paymentStatus 'Sample', no real charge).
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
# RAZORPAY_BASE_URL=https://api.razorpay.com
# RAZORPAY_WEBHOOK_SECRET=optional-test-webhook-secret

# ── Security (Phase 15) ─────────────────────────────────────────────────
# NODE_ENV=production enables strict rate limits and must be set in prod.
# NODE_ENV=production

# Comma-separated CORS allowlist. REQUIRED in production — the dev default
# only allows http://localhost:3000 and http://127.0.0.1:3000.
# CORS_ORIGIN=https://your-store.example,https://www.your-store.example

# Behind a reverse proxy (Nginx/Render/Railway), set true so rate limiting
# sees real client IPs from X-Forwarded-For.
# TRUST_PROXY=false

# Rate limits (requests per 15-minute window; defaults shown)
# RATE_LIMIT_LOGIN_FAILED_MAX=10    # prod: 10 failed logins/IP, dev: 50
# RATE_LIMIT_REGISTER_MAX=20       # prod: 20, dev: 150
# RATE_LIMIT_PAYMENT_MAX=150
# RATE_LIMIT_UPLOAD_MAX=40
# RATE_LIMIT_NOTIFICATION_MAX=300
# RATE_LIMIT_WEBHOOK_MAX=300
# RATE_LIMIT_API_WRITE_MAX=600

# ── ImageKit — product image hosting (Phase 14) ─────────────────────────
# When ALL THREE are set, product image uploads go to ImageKit's CDN.
# When absent, uploads persist locally to frontend/public/uploads (real
# files, single-instance). Never put the private key in frontend code.
# IMAGEKIT_PRIVATE_KEY=your_private_key
# IMAGEKIT_PUBLIC_KEY=your_public_key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# IMAGEKIT_FOLDER=/flora-alchemy/products

# Optional: seed the initial demo fixtures (handler + customer accounts) on boot.
# These fixtures are marked isFixture and never auto-authenticate anyone.
SEED_ON_START=true
