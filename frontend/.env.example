# Flora Alchemy frontend — environment template
# Copy to .env locally (gitignored). Backend variables live in backend/.env —
# see backend/.env.example. Vite only exposes variables prefixed with VITE_.

# ── Flora Alchemy API ───────────────────────────────────────────────────────
# Base URL read by src/services/apiClient.js. Defaults to
# http://localhost:4000/api when unset (local development).
VITE_API_URL="http://localhost:4000/api"

# ── Razorpay public key id (customer checkout) ──────────────────────────────
# Read by src/services/paymentService.js. The server returns the authoritative
# key id from /api/payments/create-order; this env value is the local-development
# convenience so the checkout script knows to load. Test-mode keys only
# (rzp_test_...). Leave empty when Razorpay is not configured.
VITE_RAZORPAY_KEY_ID=""
